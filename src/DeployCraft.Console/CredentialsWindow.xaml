<Window x:Class="DeployCraft.Console.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identifiants" Height="360" Width="640" MinHeight="260" MinWidth="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" IsCancel="True" IsDefault="True">Fermer</Button>
            <TextBlock x:Name="Warning" Foreground="{DynamicResource KoBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="Comptes administrateurs des postes. Celui par défaut sert quand un déploiement ou une planification n'en désigne pas d'autre. Les mots de passe sont chiffrés sur le serveur et ne sont jamais réaffichés." />
        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="170">
            <Button Style="{StaticResource DialogButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="Edit_Click" x:Name="EditButton">Modifier…</Button>
            <Button Style="{StaticResource DialogButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="Add_Click">Ajouter…</Button>
            <Button Style="{StaticResource DialogButton}" Margin="0,0,0,18" HorizontalAlignment="Stretch" Click="Default_Click" x:Name="DefaultButton">Définir par défaut</Button>
            <Button Style="{StaticResource DialogButton}" Margin="0" HorizontalAlignment="Stretch" Click="Remove_Click" x:Name="RemoveButton">Supprimer</Button>
        </StackPanel>
        <ListBox x:Name="List" BorderBrush="{DynamicResource PanelBorder}" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Account}" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding DefaultText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding UnreadableText}" Foreground="{DynamicResource KoBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
